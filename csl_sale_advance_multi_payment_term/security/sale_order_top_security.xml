<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_top_manager" model="res.groups">
        <field name="name">TOP Manager Approver</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[Command.link(ref('sales_team.group_sale_salesman_all_leads'))]"/>
        <field name="comment">First approval stage of sales order TOPs.</field>
    </record>

    <record id="group_top_admin" model="res.groups">
        <field name="name">TOP Admin Approver</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[
            Command.link(ref('sales_team.group_sale_salesman_all_leads')),
            Command.link(ref('account.group_account_invoice')),
        ]"/>
        <field name="comment">Final approval stage of sales order TOPs; creates the draft invoice.</field>
    </record>

    <record id="sale_order_top_rule_company" model="ir.rule">
        <field name="name">Sales Order TOP: multi-company</field>
        <field name="model_id" ref="model_sale_order_top"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="sale_order_top_rule_personal" model="ir.rule">
        <field name="name">Sales Order TOP: own orders</field>
        <field name="model_id" ref="model_sale_order_top"/>
        <field name="domain_force">['|', ('order_id.user_id', '=', user.id), ('order_id.user_id', '=', False)]</field>
        <field name="groups" eval="[Command.link(ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="sale_order_top_rule_all" model="ir.rule">
        <field name="name">Sales Order TOP: all orders</field>
        <field name="model_id" ref="model_sale_order_top"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('sales_team.group_sale_salesman_all_leads')),
                                    Command.link(ref('account.group_account_invoice'))]"/>
    </record>

    <record id="sale_order_top_history_rule_company" model="ir.rule">
        <field name="name">Sales Order TOP History: multi-company</field>
        <field name="model_id" ref="model_sale_order_top_history"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="sale_order_top_history_rule_personal" model="ir.rule">
        <field name="name">Sales Order TOP History: own orders</field>
        <field name="model_id" ref="model_sale_order_top_history"/>
        <field name="domain_force">['|', ('order_id.user_id', '=', user.id), ('order_id.user_id', '=', False)]</field>
        <field name="groups" eval="[Command.link(ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="sale_order_top_history_rule_all" model="ir.rule">
        <field name="name">Sales Order TOP History: all orders</field>
        <field name="model_id" ref="model_sale_order_top_history"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('sales_team.group_sale_salesman_all_leads')),
                                    Command.link(ref('account.group_account_invoice'))]"/>
    </record>
</odoo>
