<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_top_reject_view_form" model="ir.ui.view">
        <field name="name">sale.order.top.reject.form</field>
        <field name="model">sale.order.top.reject</field>
        <field name="arch" type="xml">
            <form string="Reject TOP">
                <group>
                    <field name="top_id" readonly="1"/>
                    <field name="reason" placeholder="Why is this TOP rejected?"/>
                </group>
                <footer>
                    <button name="action_reject" type="object" string="Reject" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="sale_order_top_reject_action" model="ir.actions.act_window">
        <field name="name">Reject TOP</field>
        <field name="res_model">sale.order.top.reject</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
