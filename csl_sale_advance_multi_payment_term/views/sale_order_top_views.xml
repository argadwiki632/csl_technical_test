<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_top_view_list" model="ir.ui.view">
        <field name="name">sale.order.top.list</field>
        <field name="model">sale.order.top</field>
        <field name="arch" type="xml">
            <list string="Sales Order TOPs" create="0">
                <field name="order_id"/>
                <field name="name"/>
                <field name="payment_term_id"/>
                <field name="estimated_invoice_date"/>
                <field name="percentage" widget="percentage"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="invoice_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('submitted', 'manager_approved')"
                       decoration-success="state == 'invoiced'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="sale_order_top_view_form" model="ir.ui.view">
        <field name="name">sale.order.top.form</field>
        <field name="model">sale.order.top</field>
        <field name="arch" type="xml">
            <form string="Sales Order TOP" create="0">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary"
                            invisible="state not in ('draft', 'rejected')"/>
                    <button name="action_approve_manager" type="object" string="Approve" class="btn-primary"
                            invisible="state != 'submitted'"
                            groups="csl_sale_advance_multi_payment_term.group_top_manager"/>
                    <button name="action_approve_admin" type="object" string="Approve &amp; Invoice" class="btn-primary"
                            invisible="state != 'manager_approved'"
                            groups="csl_sale_advance_multi_payment_term.group_top_admin"/>
                    <button name="%(sale_order_top_reject_action)d" type="action" string="Reject"
                            context="{'default_top_id': id}"
                            invisible="state not in ('submitted', 'manager_approved')"
                            groups="csl_sale_advance_multi_payment_term.group_top_manager,csl_sale_advance_multi_payment_term.group_top_admin"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('invoiced', 'cancel')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,manager_approved,invoiced"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoice" type="object" class="oe_stat_button"
                                icon="fa-pencil-square-o" string="Invoice" invisible="not invoice_id"/>
                    </div>
                    <field name="invoice_id" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="state not in ('draft', 'rejected')"/></h1>
                    </div>
                    <group>
                        <group name="top_terms">
                            <field name="percentage" string="Percentage" widget="percentage" readonly="state not in ('draft', 'rejected')"/>
                            <field name="estimated_invoice_date" readonly="state not in ('draft', 'rejected')"/>
                            <field name="payment_term_id" readonly="state not in ('draft', 'rejected')"/>
                            <field name="partner_bank_id" readonly="state not in ('draft', 'rejected')"
                                   context="{'default_partner_id': commercial_partner_id}"/>
                        </group>
                        <group name="top_info">
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="order_id" readonly="1"/>
                            <field name="commercial_partner_id" string="Customer"/>
                            <field name="manager_approver_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Term Note" name="note">
                            <field name="note" readonly="state not in ('draft', 'rejected')"/>
                        </page>
                        <page string="Approval History" name="history">
                            <field name="history_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="action"/>
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="reason"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="sale_order_top_view_search" model="ir.ui.view">
        <field name="name">sale.order.top.search</field>
        <field name="model">sale.order.top</field>
        <field name="arch" type="xml">
            <search>
                <field name="order_id"/>
                <field name="name"/>
                <filter name="to_approve_manager" string="Waiting Manager Approval"
                        domain="[('state', '=', 'submitted')]"/>
                <filter name="to_approve_admin" string="Waiting Admin Approval"
                        domain="[('state', '=', 'manager_approved')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_order" string="Sales Order" context="{'group_by': 'order_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sale_order_top_action" model="ir.actions.act_window">
        <field name="name">TOP Approvals</field>
        <field name="res_model">sale.order.top</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_approve_manager': 1, 'search_default_to_approve_admin': 1, 'group_by': 'order_id'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No TOP waiting for approval</p>
            <p>TOPs are scheduled on confirmed sales orders and submitted for approval from there.</p>
        </field>
    </record>

    <menuitem id="sale_order_top_menu"
              action="sale_order_top_action"
              parent="sale.menu_sale_invoicing"
              sequence="30"/>
</odoo>
