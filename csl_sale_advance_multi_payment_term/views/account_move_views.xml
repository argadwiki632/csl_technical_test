<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_top" model="ir.ui.view">
        <field name="name">account.move.form.inherit.top</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="payment_reference" position="after">
                <field name="sale_top_id" invisible="not sale_top_id"/>
                <field name="top_partner_bank_id" invisible="not top_partner_bank_id"/>
            </field>
        </field>
    </record>
</odoo>
