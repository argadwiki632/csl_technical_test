<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_top" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.top</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <page name="order_lines" position="after">
                <page string="TOP Schedule" name="top_schedule">
                    <field name="top_ids" context="{'default_order_id': id}">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name" readonly="state not in ('draft', 'rejected')"/>
                            <field name="note" optional="show" readonly="state not in ('draft', 'rejected')"/>
                            <field name="estimated_invoice_date" readonly="state not in ('draft', 'rejected')"/>
                            <field name="payment_term_id" optional="show" readonly="state not in ('draft', 'rejected')"/>
                            <field name="commercial_partner_id" column_invisible="True"/>
                            <field name="partner_bank_id" optional="show" readonly="state not in ('draft', 'rejected')"
                                   context="{'default_partner_id': commercial_partner_id}"/>
                            <field name="percentage" widget="percentage" sum="Total" readonly="state not in ('draft', 'rejected')"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="amount" sum="Total"/>
                            <field name="state" widget="badge"
                                   decoration-info="state in ('submitted', 'manager_approved')"
                                   decoration-success="state == 'invoiced'"
                                   decoration-danger="state == 'rejected'"/>
                            <field name="invoice_id" optional="show"/>
                            <button name="action_submit" type="object" string="Submit" icon="fa-paper-plane"
                                    invisible="state not in ('draft', 'rejected') or parent.state != 'sale'"/>
                            <button name="action_approve_manager" type="object" string="Approve" icon="fa-check"
                                    invisible="state != 'submitted'"
                                    groups="csl_sale_advance_multi_payment_term.group_top_manager"/>
                            <button name="action_approve_admin" type="object" string="Approve &amp; Invoice"
                                    icon="fa-check-circle" invisible="state != 'manager_approved'"
                                    groups="csl_sale_advance_multi_payment_term.group_top_admin"/>
                            <button name="%(sale_order_top_reject_action)d" type="action" string="Reject"
                                    icon="fa-times" context="{'default_top_id': id}"
                                    invisible="state not in ('submitted', 'manager_approved')"
                                    groups="csl_sale_advance_multi_payment_term.group_top_manager,csl_sale_advance_multi_payment_term.group_top_admin"/>
                        </list>
                    </field>
                    <group name="top_breakdown" string="Summary Breakdown" class="oe_right">
                        <field name="top_percentage_total" widget="percentage" class="fw-bolder"/>
                        <field name="top_amount_total" class="fw-bolder"/>
                        <field name="top_invoiced_amount" class="fw-bolder"/>
                        <field name="top_remaining_amount" class="fw-bolder"/>
                    </group>
                </page>
            </page>
        </field>
    </record>
</odoo>
